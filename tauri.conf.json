{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Æ Strøm",
  "version": "0.1.1",
  "identifier": "local.edwardap.ae-strom",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Æ Strøm",
        "create": false,
        "width": 725,
        "height": 36,
        "minWidth": 100,
        "minHeight": 32,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "dragDropEnabled": false,
        "generalAutofillEnabled": false,
        "devtools": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        {
          "identifier": "radio-main-only",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "allow-get-snapshot",
            "allow-dispatch-action",
            "allow-set-window-layout",
            "allow-start-drag",
            "allow-copy-title",
            "allow-shutdown",
            "allow-save-ui-evidence",
            "allow-ui-ready"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
